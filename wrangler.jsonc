{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unlockaffiliate",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-24",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "35bc7a4522237728214ba9d54c36002e",
  "vars": {
    "STRIPE_PRICE_GROWTH_MONTHLY": "price_1SzvXBR8lpKvtDuLtYpOzWEQ",
    "STRIPE_PRICE_GROWTH_ANNUAL": "price_1T9ixBR8lpKvtDuL7Kj845YN",
    "STRIPE_PRICE_SCALE_MONTHLY": "price_1SzvYjR8lpKvtDuL9ObPOIrk",
    "STRIPE_PRICE_SCALE_ANNUAL": "price_1T396ZR8lpKvtDuLC6aUmJgt"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlockaffiliate-db",
      "database_id": "eba98925-3b0c-44b7-b4ac-a26c1171a9a4",
      "migrations_dir": "worker/db/drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "unlockaffiliate-uploads",
    },
  ],
  "triggers": {
    "crons": ["0 6 * * *"],
  },
}
