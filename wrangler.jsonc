{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "indieaffiliate",
	"main": "worker/index.ts",
	"compatibility_date": "2025-05-24",
	"compatibility_flags": ["nodejs_compat"],
	"account_id": "35bc7a4522237728214ba9d54c36002e",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "indieaffiliate-db",
			"database_id": "eba98925-3b0c-44b7-b4ac-a26c1171a9a4",
			"migrations_dir": "worker/db/drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "indieaffiliate-uploads"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:8080"
	},
	"triggers": {
		"crons": ["0 6 * * *"]
	}
}
